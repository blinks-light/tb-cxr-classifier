# Example of the .env that the CD workflows materialise from repository secrets.
# Copy to .env for local use; .env itself is git-ignored and docker-ignored.

# stderr log level: DEBUG | INFO | WARNING | ERROR
TBCXR_LOG_LEVEL=INFO

# onnxruntime intra-op threads; keep <= the container CPU quota
TBCXR_INTRA_OP_THREADS=2

# which environment this deployment represents
DEPLOY_ENV=local

# optional: point the service at a different artifact directory
# TBCXR_ARTIFACTS_DIR=/app/artifacts
